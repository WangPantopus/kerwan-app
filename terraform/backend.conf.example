# ─────────────────────────────────────────────────────────────────────────────
# Terraform remote state — Cloudflare R2 (S3-compatible backend)
#
# Copy this file to backend.conf, fill in your values, then run:
#   terraform init -backend-config=backend.conf
#
# backend.conf is .gitignored — never commit it.
#
# Bootstrap (first-time only)
# ───────────────────────────
# Create the state bucket before running terraform init:
#
#   export AWS_ACCESS_KEY_ID=<R2_ACCESS_KEY_ID>
#   export AWS_SECRET_ACCESS_KEY=<R2_SECRET_ACCESS_KEY>
#
#   aws s3api create-bucket \
#     --bucket kerwan-tf-state \
#     --endpoint-url https://<ACCOUNT_ID>.r2.cloudflarestorage.com \
#     --region auto
#
# R2 API token:
#   Create at Cloudflare Dashboard → R2 → Manage R2 API Tokens
#   with "Object Read & Write" permission on the kerwan-tf-state bucket.
#   (Use a separate token from the main cloudflare_api_token for least privilege.)
# ─────────────────────────────────────────────────────────────────────────────

bucket   = "kerwan-tf-state"
key      = "infra/terraform.tfstate"
region   = "auto"
endpoint = "https://<ACCOUNT_ID>.r2.cloudflarestorage.com"

access_key = "<R2_ACCESS_KEY_ID>"
secret_key = "<R2_SECRET_ACCESS_KEY>"

skip_credentials_validation = true
skip_metadata_api_check     = true
skip_region_validation      = true
force_path_style            = true
